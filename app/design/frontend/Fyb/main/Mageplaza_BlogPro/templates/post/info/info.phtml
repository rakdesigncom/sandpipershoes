use Mageplaza\Blog\Block\Post\View;

/** @var View $block */
$helper    = $block->getBlogHelper();
$_post     = $block->getPost();
$helperPro = $this->helper('Mageplaza\BlogPro\Helper\Data');
?>
<hr/>
<div class="mp-post-info col-mp mp-12">
    <?= $block->getChildHtml('mp_blog_post_info_date') ?>
    <?= $block->getChildHtml('mp_blog_post_info_edited') ?>
    <?= $block->getChildHtml('mp_blog_post_info_traffic') ?>
    <?= $block->getChildHtml('mp_blog_post_info_category') ?>
    <?= $block->getChildHtml('mp_blog_post_info_read_time') ?>
    <?php if (($tagList = $helperPro->getPostTagList($_post)) && $helper->getPostViewPageConfig('display_tags')) : ?>
        | <span><i class="fa fa-tags"></i><?= __('Tags: %1', $tagList) ?></span>
    <?php endif; ?>
</div>

<div class="mp-clear"></div>
