<?xml version="1.0"?>

<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="page.main.title" remove="true" />
        <referenceContainer name="content">
            <block class="Webkul\RewardSystem\Block\RewardPoints" name="rewardsystem.index.index" template="Webkul_RewardSystem::rewardPoints.phtml" cacheable="false">
                <arguments>
                    <argument name="reward_view_model" xsi:type="object">Webkul\RewardSystem\ViewModel\Reward</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
