<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Customer\Model\Registration">
        <plugin name="Fyb_Trade::disableTradeLogin"
                type="Fyb\Trade\Plugin\DisableRegistration" />
    </type>
    <preference for="Magento\Checkout\Controller\Cart\Add" type="Fyb\Trade\Controller\Cart\Add"/>
    <type name="Magento\Checkout\Block\Checkout\LayoutProcessor">
        <plugin name="Fyb_Trade::TradeFields"
                type="Fyb\Trade\Plugin\TradeFields"
                sortOrder="99"/>
    </type>
    <type name="Magento\Quote\Model\ShippingAddressManagement">
        <plugin name="Fyb_Trade::ShippingAddressExtensionAttributes"
                type="Fyb\Trade\Plugin\ShippingAddress"/>
    </type>
    <type name="Magento\Customer\Block\Address\Edit">
        <plugin name="Fyb_Trade::DisableBillingAddressChange"
                type="Fyb\Trade\Plugin\DisableBillingAddressChange"/>
    </type>
</config>
