<?xml version="1.0"?>

<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="page.wrapper">
            <block class="Magento\Newsletter\Block\Subscribe" name="block.newsletter" after="page.bottom.container" template="Magento_Theme::newsletter.phtml"/>
        </referenceContainer>

        <referenceContainer name="content">
            <block class="Magento\Cms\Block\Block" name="main.sandals_slippers">
                <arguments>
                    <argument name="block_id" xsi:type="string">thankyou_request_catalogue</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>

