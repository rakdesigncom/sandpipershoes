<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <body>
        <referenceBlock name="productalert.price" remove="true"/>
        <referenceBlock name="productalert.stock" remove="true"/>

        <referenceBlock name="product.info.options.wrapper.bottom">
            <block class="Fyb\OutOfStockNotification\Block\OutOfStock" name="productalert.outofstock" before="product.info.sizes" template="Fyb_OutOfStockNotification::stock_alert.phtml" />
        </referenceBlock>
    </body>
</page>
